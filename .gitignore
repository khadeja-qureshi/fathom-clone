# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Keep agent capture logs in the repo
!.agent-logs/
!.agent-logs/**

# Internal hook state/debug
.agent-logs/.session-state.json
.agent-logs/.hook-debug.log
.agent-logs/.last-stdin.bin
.agent-logs/.last-payload.json
